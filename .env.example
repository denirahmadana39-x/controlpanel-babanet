# =====================================================================
# Hosting Panel — Environment
# Copy this file to `.env` (pnpm setup) and fill in real values.
# .env is gitignored. Never commit real credentials.
# =====================================================================

# ---- Runtime (API / Worker) -----------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ---- URLs ------------------------------------------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---- Database (PostgreSQL 16, container "postgres") ------------------
# Format: postgresql://USER:PASSWORD@HOST:5432/hosting_panel?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hosting_panel?schema=public

# ---- Auth (JWT + cookies) --------------------------------------------
# Generate secrets with `openssl rand -hex 32` (both must be >= 32 chars).
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET_0001
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET_0002
JWT_ISSUER=hosting-panel
JWT_AUDIENCE=hosting-panel-api
ACCESS_TOKEN_TTL=15m
SESSION_TTL_HOURS=8
REMEMBER_ME_TTL_DAYS=30

# Cookies: COOKIE_SECURE must be "true" in production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---- CORS (admin + client dev servers) --------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Filesystem directories (no hardcoded paths in code) --------------
UPLOAD_DIRECTORY=/var/uploads
SITE_DIRECTORY=/var/www/sites
BACKUP_DIRECTORY=/var/backups
LOG_DIRECTORY=/var/log/hosting
TEMP_DIRECTORY=/tmp/hosting-panel

# ---- Deployment engine limits ------------------------------------------
UPLOAD_MAX_SIZE_MB=100
MAX_ZIP_ENTRIES=10000
MAX_EXTRACTED_SIZE_MB=500
VERSION_RETENTION=5
TEMP_AGE_HOURS=24

# ---- Nginx --------------------------------------------------------------
PUBLIC_BASE_DOMAIN=localhost
NGINX_PORT=80
NGINX_BIN=nginx
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_TEMP_DIR=/tmp/hosting-panel
NGINX_SERVE_ROOT=/var/www/sites

# ---- Worker -------------------------------------------------------------
WORKER_POLL_MS=2000
WORKER_HEARTBEAT_MS=30000
MAX_ATTEMPTS=3
STALE_AFTER_MINUTES=10

# ---- Seed --------------------------------------------------------------
# ADMIN_EMAIL=admin@hosting.local
# ADMIN_PASSWORD=Admin12345!
